# Copy to .env and adjust. .env is gitignored.

APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080

DATABASE_URL=postgres://edvexa:edvexa@localhost:5432/edvexa?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s

READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Read by docker-compose.yml. If 5432 is already taken on your machine, set
# POSTGRES_PORT to something free and change the port in DATABASE_URL to match.
POSTGRES_USER=edvexa
POSTGRES_PASSWORD=edvexa
POSTGRES_DB=edvexa
POSTGRES_PORT=5432
